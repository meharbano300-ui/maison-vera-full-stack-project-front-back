# Frontend environment variables (Vite)
#
# In local development you usually don't need this file at all — Vite's dev
# server proxies /api requests to http://localhost:5000 (see vite.config.ts),
# so the default value below is fine.
#
# Set VITE_API_URL only when the backend is hosted somewhere else, e.g. when
# deploying the frontend and backend separately in production.

VITE_API_URL=/api
